{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eg4-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // global_fetch_strictly_public: required by the OAuth provider for safe
  // Client ID Metadata Document fetches (SSRF protection).
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "kv_namespaces": [
    {
      // OAuth grants/tokens (workers-oauth-provider) plus this server's cache:
      // encrypted EG4 session cookies, device lists and the change audit log ("eg4mcp:" keys).
      "binding": "OAUTH_KV",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ],
  "vars": {
    // Public origin of this Worker. It becomes the OAuth issuer and MCP resource id; set it before the first deploy.
    "PUBLIC_BASE_URL": "https://eg4-mcp.REPLACE.workers.dev",
    "EG4_BASE_URL": "https://monitor.eg4electronics.com"
  },
  // Secrets (set with `wrangler secret put`):
  //   EG4_CACHE_KEY  base64-encoded 32 random bytes; encrypts cached EG4 session cookies
  "triggers": {
    // Daily sweep of expired OAuth grants and tokens.
    "crons": ["23 11 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
